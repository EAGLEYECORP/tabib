# Copy to .env.local and fill in. Only the first three are needed to run the
# app; everything below them has a working default or an inert one.

# ---------------------------------------------------------------------------
# Supabase — Project settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-side only, and never exposed to the browser: it bypasses every
# row-level security policy in supabase/schema.sql. Needed by the
# notification drain, which has to read an outbox no user can read.
SUPABASE_SERVICE_ROLE_KEY=

# The database, for `npm run db:apply` and `npm run db:seed`.
# Project settings → Database → Connection string (URI).
DATABASE_URL=

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
# The shared secret /api/notifications requires. Without it the endpoint
# refuses everything, so set it before scheduling the drain:
#   openssl rand -hex 32
NOTIFY_SECRET=

# log (the default) writes messages to the server log, which is enough to see
# the whole chain working. twilio actually sends them.
SMS_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
